---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd" xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}/</loc>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
{%- for page in site.pages %}
  {%- comment %} HTML pages only: skip feeds/text files, 404, paginated copies of the home page, and pages opting out {% endcomment -%}
  {%- if page.layout and page.sitemap != false and page.url != "/" and page.name != "404.html" -%}
  {%- unless page.url contains "/page" or page.url contains ".xml" or page.url contains ".txt" %}
  <url>
    <loc>{{ site.url }}{{ page.url }}</loc>
    {%- if page.last_modified_at %}
    <lastmod>{{ page.last_modified_at | date_to_xmlschema }}</lastmod>
    {%- endif %}
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  {%- endunless -%}
  {%- endif -%}
{%- endfor %}
{%- for post in site.posts %}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
    {%- if post.last_modified_at %}
    <lastmod>{{ post.last_modified_at | date_to_xmlschema }}</lastmod>
    {%- elsif post.lastmod %}
    <lastmod>{{ post.lastmod | date_to_xmlschema }}</lastmod>
    {%- else %}
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
    {%- endif %}
    <changefreq>{{ post.sitemap.changefreq | default: "yearly" }}</changefreq>
    <priority>{{ post.sitemap.priority | default: "0.5" }}</priority>
  </url>
{%- endfor %}
</urlset>
